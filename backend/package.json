{
  "name": "chandra-precision-erp-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Enterprise Express.js backend with PostgreSQL for Chandra Precision ERP",
  "main": "src/app.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "node --test tests/**/*.test.js",
    "test:watch": "node --test --watch tests/**/*.test.js",
    "seed:countries": "node scripts/seed_countries.mjs",
    "verify:schema": "node scripts/verify_schema.mjs",
    "db:verify": "node scripts/verify_schema.mjs",
    "db:migrate": "node scripts/migrate_all.mjs",
    "db:seed:users": "node scripts/seed_users.mjs"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "compression": "1.7.4",
    "cookie-parser": "1.4.6",
    "cors": "2.8.5",
    "dotenv": "16.3.1",
    "express": "4.18.2",
    "express-rate-limit": "8.6.2",
    "express-validator": "7.2.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.2",
    "pg": "8.11.3",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "nodemon": "3.0.1",
    "pino-pretty": "10.3.0"
  }
}
