# ==============================================================================
# Chandra Precision ERP — Backend Environment Configuration Example
# ==============================================================================

# Server Runtime Environment (production | development | test)
NODE_ENV=development
PORT=5000

# Logging Level (fatal | error | warn | info | debug | trace)
LOG_LEVEL=info

# PostgreSQL Database Connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_NAME=sme_erp
DB_SSL=false

# JWT Cryptographic Secrets (Generate with: openssl rand -hex 32)
# IMPORTANT: Never reuse the same secret for both Access and Refresh tokens
JWT_ACCESS_SECRET=your_256bit_hex_access_token_secret_here_replace_in_prod
JWT_REFRESH_SECRET=your_256bit_hex_refresh_token_secret_here_replace_in_prod
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS Allowed Client Origins (Comma-separated list of exact origin URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Initial Bootstrap Super Admin Credentials
SUPER_ADMIN_EMAIL=admin@chandraprecision.com
SUPER_ADMIN_PASSWORD=Admin@2026#Secure
SUPER_ADMIN_ROLE=super_admin
